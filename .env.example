# MarketStudio Environment Template (NEVER commit real secrets to .env or git)
# Default profile uses local SQLite with zero external dependencies.

MARKETSTUDIO_ENV=development
MARKETSTUDIO_HOST=127.0.0.1
MARKETSTUDIO_PORT=8000

# Database backend selector: "sqlite" (default) or "postgres"
MARKETSTUDIO_DB_BACKEND=sqlite
MARKETSTUDIO_DB_PATH=data/marketstudio.db

# PostgreSQL / Supabase runtime connection (required only when MARKETSTUDIO_DB_BACKEND=postgres)
# Example Supavisor / PgBouncer transaction pooler URL (replace placeholders in runtime env only):
# DATABASE_URL=postgresql://<pool_user>:<password>@<pooler_host>:6543/postgres?sslmode=require
# Optional direct migration connection (used by `python3 -m app.migrations` when preferred over DATABASE_URL):
# DIRECT_DATABASE_URL=postgresql://<migrator_user>:<password>@<direct_host>:5432/postgres?sslmode=require

# Optional PostgreSQL driver & pool tuning
# MARKETSTUDIO_PG_SSLMODE=require
# MARKETSTUDIO_AUTO_MIGRATE=1
# MARKETSTUDIO_DB_POOL_MIN=1
# MARKETSTUDIO_DB_POOL_MAX=10
# MARKETSTUDIO_DB_CONNECT_TIMEOUT=10
# MARKETSTUDIO_PG_PREPARE_THRESHOLD=
# MARKETSTUDIO_DB_STATEMENT_TIMEOUT_MS=15000

# Optional AI Business Review provider config
# MARKETSTUDIO_AI_PROVIDER=gemini
# MARKETSTUDIO_AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=<your-gemini-api-key>
